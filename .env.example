# ---------------------------------------------------------------------------
# Microsoft Foundry (Azure AI Foundry / Azure OpenAI)
# ---------------------------------------------------------------------------
# Endpoint do recurso, sem barra final e sem sufixo de rota.
# Foundry:              https://<recurso>.services.ai.azure.com
# Azure OpenAI classico: https://<recurso>.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.services.ai.azure.com

# API version usada pelo endpoint de imagem (gpt-image-2)
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# OPCIONAL. Se vazio, a aplicacao usa DefaultAzureCredential (Entra ID).
# Recomendado deixar vazio em producao e usar RBAC (role "Cognitive Services User").
AZURE_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Deployments
# ---------------------------------------------------------------------------
IMAGE_MODEL_DEPLOYMENT=gpt-image-2

# ---------------------------------------------------------------------------
# Geracao de imagem
# ---------------------------------------------------------------------------
# Tamanho nativo enviado a API. O retorno nao e redimensionado.
GPT_IMAGE_2_SIZE=1024x1536
# Parametros para reduzir custo, latencia e tamanho do arquivo.
IMAGE_QUALITY=low
IMAGE_OUTPUT_FORMAT=jpeg
IMAGE_OUTPUT_COMPRESSION=80
IMAGE_TIMEOUT_SECONDS=180

# Precos globais estimados em USD por 1 milhao de tokens.
# Ajuste estes valores conforme sua regiao e seu contrato Azure.
GPT_IMAGE_2_INPUT_TEXT_PRICE_PER_1M=5.00
GPT_IMAGE_2_INPUT_IMAGE_PRICE_PER_1M=8.00
GPT_IMAGE_2_OUTPUT_IMAGE_PRICE_PER_1M=30.00

# ---------------------------------------------------------------------------
# Marca do cliente
# ---------------------------------------------------------------------------
BRAND_NAME=Virtual Try-On
# Cor de destaque em hexadecimal (#rgb ou #rrggbb)
BRAND_ACCENT_COLOR=#eb0a1e

# ---------------------------------------------------------------------------
# Limites e operacao
# ---------------------------------------------------------------------------
MAX_GARMENTS=5
MAX_UPLOAD_MB=10
RATE_LIMIT_IMAGE_PER_MINUTE=6
# Origens permitidas no CORS, separadas por virgula
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
