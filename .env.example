# ---------------------------------------------------------------------------
# Microsoft Foundry (Azure AI Foundry / Azure OpenAI)
# ---------------------------------------------------------------------------
# Endpoint do recurso, sem barra final e sem sufixo de rota.
# Foundry:              https://<recurso>.services.ai.azure.com
# Azure OpenAI classico: https://<recurso>.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.services.ai.azure.com

# OPCIONAL. Endpoint do recurso que hospeda os deployments FLUX.
# Se vazio, a aplicacao reutiliza AZURE_OPENAI_ENDPOINT.
AZURE_FLUX_ENDPOINT=
AZURE_FLUX_API_VERSION=preview

# API version usada pelo endpoint de imagem (gpt-image-2)
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# API version usada pela Video API (sora-2). Durante o preview, use "preview".
AZURE_VIDEO_API_VERSION=preview

# OPCIONAL. Se vazio, a aplicacao usa DefaultAzureCredential (Entra ID).
# Recomendado deixar vazio em producao e usar RBAC (role "Cognitive Services User").
AZURE_OPENAI_API_KEY=

# Escopo do token Entra ID. Para recursos Azure OpenAI classicos use o valor abaixo.
# Para projetos Microsoft Foundry use: https://ai.azure.com/.default
AZURE_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# ---------------------------------------------------------------------------
# Deployments
# ---------------------------------------------------------------------------
IMAGE_MODEL_DEPLOYMENT=gpt-image-2
IMAGE_MINI_MODEL_DEPLOYMENT=gpt-image-1-mini
FLUX_2_PRO_DEPLOYMENT=FLUX.2-pro
FLUX_2_FLEX_DEPLOYMENT=FLUX.2-flex
VIDEO_MODEL_DEPLOYMENT=sora-2

# ---------------------------------------------------------------------------
# Geracao de imagem
# ---------------------------------------------------------------------------
# Tamanhos nativos enviados a cada API. O retorno nao e redimensionado.
GPT_IMAGE_2_SIZE=1024x1536
GPT_IMAGE_1_MINI_SIZE=1024x1536
FLUX_IMAGE_SIZE=300x400
# Parametros para reduzir custo, latencia e tamanho do arquivo.
IMAGE_QUALITY=low
IMAGE_OUTPUT_FORMAT=jpeg
IMAGE_OUTPUT_COMPRESSION=80
IMAGE_TIMEOUT_SECONDS=180

# Precos globais estimados em USD por 1 milhao de tokens.
# Ajuste estes valores conforme sua regiao e seu contrato Azure.
GPT_IMAGE_2_INPUT_TEXT_PRICE_PER_1M=5.00
GPT_IMAGE_2_INPUT_IMAGE_PRICE_PER_1M=8.00
GPT_IMAGE_2_OUTPUT_IMAGE_PRICE_PER_1M=30.00
GPT_IMAGE_1_MINI_INPUT_TEXT_PRICE_PER_1M=2.00
GPT_IMAGE_1_MINI_INPUT_IMAGE_PRICE_PER_1M=2.50
GPT_IMAGE_1_MINI_OUTPUT_IMAGE_PRICE_PER_1M=8.00
# Precos globais FLUX.2 em USD por megapixel.
FLUX_2_PRO_INITIAL_MP_PRICE=0.03
FLUX_2_PRO_MP_PRICE=0.015
FLUX_2_PRO_REF_MP_PRICE=0.015
FLUX_2_FLEX_MP_PRICE=0.05
FLUX_2_FLEX_REF_MP_PRICE=0.05

# ---------------------------------------------------------------------------
# Geracao de video
# ---------------------------------------------------------------------------
# 4 | 8 | 12
VIDEO_DEFAULT_DURATION=8
# 720x1280 (vertical) | 1280x720 (horizontal)
VIDEO_DEFAULT_RESOLUTION=720x1280
VIDEO_TIMEOUT_SECONDS=600
MAX_CONCURRENT_VIDEO_JOBS=2

# ---------------------------------------------------------------------------
# Marca do cliente
# ---------------------------------------------------------------------------
BRAND_NAME=Virtual Try-On
# Cor de destaque em hexadecimal (#rgb ou #rrggbb)
BRAND_ACCENT_COLOR=#eb0a1e

# ---------------------------------------------------------------------------
# Limites e operacao
# ---------------------------------------------------------------------------
MAX_GARMENTS=5
MAX_UPLOAD_MB=10
RATE_LIMIT_IMAGE_PER_MINUTE=6
RATE_LIMIT_VIDEO_PER_MINUTE=2
# Origens permitidas no CORS, separadas por virgula
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
